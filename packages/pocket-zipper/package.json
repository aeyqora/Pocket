{
  "name": "pocket-zipper",
  "version": "0.1.0",
  "description": "Gate a proposed change from adding new ESLint suppression debt.",
  "keywords": [
    "eslint",
    "suppression",
    "debt",
    "ratchet",
    "ci",
    "quality-gate"
  ],
  "author": {
    "name": "aeyqora",
    "email": "git@aeyqora.com"
  },
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/aeyqora/Pocket#readme",
  "bugs": {
    "url": "https://github.com/aeyqora/Pocket/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aeyqora/Pocket.git"
  },
  "bin": {
    "pocket-zipper": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test \"test/**/*.test.ts\"",
    "test:one": "node --import tsx --test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  }
}
